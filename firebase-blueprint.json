{
  "entities": {
    "Subscriber": {
      "title": "Subscriber",
      "description": "Newsletter subscriber captured from the DEBLOOM footer signup form",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Subscriber email address"
        },
        "subscribedAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of subscription"
        },
        "source": {
          "type": "string",
          "description": "Origin of subscriber capture, e.g. footer_newsletter"
        },
        "status": {
          "type": "string",
          "enum": ["active", "unsubscribed"],
          "description": "Status of subscription"
        }
      },
      "required": ["email", "subscribedAt"]
    }
  },
  "firestore": {
    "/subscribers/{subscriberId}": {
      "schema": "Subscriber",
      "description": "Stores newsletter subscribers from the website footer"
    }
  }
}
